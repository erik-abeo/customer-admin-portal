{
  "$comment": [
    "ECS Fargate task definition for the Customer Admin Portal.",
    "Replace the values surrounded by <ANGLE_BRACKETS> for your account / region.",
    "",
    "Deploy with:",
    "  aws ecs register-task-definition --cli-input-json file://deploy/ecs-task-definition.json",
    "",
    "Then create / update a service that uses this task definition behind an",
    "ALB target group on port 8080. The container is ROOTLESS (uid 101) and",
    "listens on 8080, so there is no need for awsvpc port mappings to 80/443.",
    "",
    "The SPA has no runtime configuration. Every VITE_* value, the Sentry DSN",
    "and audit-sink URL included, is baked in at image build with --build-arg",
    "(see deploy/README.md), so none of them belongs here: the container is",
    "nginx serving static files, and environment variables never reach the",
    "bundle."
  ],
  "family": "customer-admin-portal",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/customer-admin-portal-task",
  "containerDefinitions": [
    {
      "name": "web",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/customer-admin-portal:<IMAGE_TAG>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "readonlyRootFilesystem": false,
      "user": "101",
      "environment": [
        {
          "name": "TZ",
          "value": "UTC"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/customer-admin-portal",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "web",
          "awslogs-create-group": "true"
        }
      },
      "linuxParameters": {
        "initProcessEnabled": true
      },
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 65535,
          "hardLimit": 65535
        }
      ]
    }
  ]
}
