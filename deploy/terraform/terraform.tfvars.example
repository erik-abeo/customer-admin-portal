# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
region                    = "us-east-1"
environment               = "production"
ecs_cluster_name          = "platform-prod"
vpc_id                    = "vpc-0123456789abcdef0"
private_subnet_ids        = ["subnet-aaa", "subnet-bbb", "subnet-ccc"]
alb_listener_arn          = "arn:aws:elasticloadbalancing:us-east-1:123456789012:listener/app/internal/abc/def"
alb_security_group_id     = "sg-0123456789abcdef0"
host_header               = "admin.example.internal"
image_tag                 = "latest"
