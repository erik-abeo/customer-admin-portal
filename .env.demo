# Demo-mode environment.
#
# Loaded by Vite when the build / dev server is started with
# `--mode demo`. Activates the in-memory adapter in src/demo/ which
# serves rich fixture data for every API endpoint, so the SPA can be
# demonstrated end-to-end without the ASP.NET backend running.
#
# DO NOT copy these values into production environments.

VITE_API_BASE_URL=https://demo.invalid
VITE_API_CONTROLLER_PREFIX=/My
VITE_APP_NAME=Customer Admin Portal (demo)
VITE_ENVIRONMENT=demo

# Switch on every flag-gated module so the team can see the full
# administrative surface area during the walkthrough.
VITE_FEATURE_DUMPS=true
VITE_FEATURE_EVENT_LOG=true
VITE_FEATURE_DELETES=true
VITE_FEATURE_RBAC=true
VITE_FEATURE_AUDIT_SINK=false
VITE_AUDIT_SINK_URL=

# Generous idle window so the demo doesn't time out mid-presentation.
VITE_IDLE_TIMEOUT_MINUTES=120
VITE_IDLE_WARN_MINUTES=2

# THE flag. Triggers main.tsx to dynamically import installDemo and
# patch the axios layer.
VITE_DEMO_MODE=true
