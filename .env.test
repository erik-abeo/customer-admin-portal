VITE_API_BASE_URL=http://api.test
VITE_API_CONTROLLER_PREFIX=/My
VITE_APP_NAME=Customer Admin Portal (test)
# Enable feature-flagged surfaces for E2E coverage. The flags default to
# false in production builds; flipping them on here lets the Playwright
# suite exercise Dumps and Event Log without changing app behavior in
# real environments.
#
# RBAC is intentionally LEFT OFF: when on, the role store starts at
# "viewer" until an X-Admin-Role response header is captured, and that
# extra round-trip introduces flakiness in tests that don't care about
# RBAC. RBAC gating logic is covered by `src/auth/RequireRole.test.tsx`
# (which mocks features.rbac=true at the unit level).
VITE_FEATURE_DUMPS=true
VITE_FEATURE_EVENT_LOG=true
VITE_FEATURE_DELETES=true
