# Customer Admin Portal — environment configuration.
# Copy to `.env.local` for development, or supply via your container
# orchestration (ECS task definition / Kubernetes secret / Docker env).

# ---- REQUIRED ------------------------------------------------------------

# Base URL of the ASP.NET ClientRemoteDatabaseAccessAPI service.
# Do NOT include the controller prefix here — that goes in
# VITE_API_CONTROLLER_PREFIX.
VITE_API_BASE_URL=https://api.example.internal

# ---- OPTIONAL ------------------------------------------------------------

# Controller prefix on the backend service. Defaults to "/My".
VITE_API_CONTROLLER_PREFIX=/My

# UI app title (browser tab + login page eyebrow). Defaults to
# "Customer Admin Portal".
VITE_APP_NAME=Customer Admin Portal

# Environment label surfaced to Sentry / observability.
VITE_ENVIRONMENT=development

# ---- FEATURE FLAGS (default: off) ---------------------------------------

# Enable the Dumps page (requires backend dump endpoints — see
# BACKEND-CONTRACT.md).
VITE_FEATURE_DUMPS=false

# Enable the Event Log viewer (requires backend event-log endpoints).
VITE_FEATURE_EVENT_LOG=false

# Enable Delete actions for database servers, databases, and static users
# (requires the corresponding backend DELETE endpoints).
VITE_FEATURE_DELETES=false

# Enable Role-Based Access Control gating. When false, every signed-in
# admin has full write access. When true, the X-Admin-Role response header
# from the backend determines what they can do.
VITE_FEATURE_RBAC=false

# When true, every administrative write is mirrored to a backend audit
# log via POST to VITE_AUDIT_SINK_URL. Requires the backend audit endpoint.
VITE_FEATURE_AUDIT_SINK=false
VITE_AUDIT_SINK_URL=

# ---- SESSION POLICY -----------------------------------------------------

# Hard idle threshold (minutes). After this much inactivity the portal
# force-signs the operator out. Set to 0 to disable. Default: 30.
# Range: 0–1440.
VITE_IDLE_TIMEOUT_MINUTES=30

# Warning window (minutes) shown before the hard sign-out fires. Set to 0
# to suppress the warning toast (still signs out at the hard threshold).
# Default: 1. Range: 0–30. Must be < VITE_IDLE_TIMEOUT_MINUTES.
VITE_IDLE_WARN_MINUTES=1

# ---- OBSERVABILITY ------------------------------------------------------

# Sentry DSN. When set, browser error tracking activates automatically.
# Leave blank in development.
VITE_SENTRY_DSN=
