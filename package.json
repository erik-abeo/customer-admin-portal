{
  "name": "customer-admin-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Internal web portal for managing remote-database customers, database servers, databases, authorized users, and static database users.",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo --host 127.0.0.1 --port 5173",
    "demo:build": "tsc -b && vite build --mode demo",
    "demo:preview": "npm run demo:build && vite preview --mode demo --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"deploy/**/*.{md,json}\" \"*.{json,md,html,cjs,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"deploy/**/*.{md,json}\" \"*.{json,md,html,cjs,mjs,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "e2e:serve": "vite build --mode test && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@mantine/core": "^7.13.4",
    "@mantine/form": "^7.13.4",
    "@mantine/hooks": "^7.13.4",
    "@mantine/modals": "^7.13.4",
    "@mantine/notifications": "^7.13.4",
    "@mantine/nprogress": "^7.17.8",
    "@mantine/spotlight": "^7.17.8",
    "@sentry/react": "^8.55.1",
    "@tabler/icons-react": "^3.21.0",
    "@tanstack/react-query": "^5.59.16",
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.59.1",
    "@tanstack/react-query-devtools": "^5.59.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.11.3",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
