VITE_API_BASE_URL=http://127.0.0.1:4174
VITE_API_CONTROLLER_PREFIX=/My
VITE_APP_NAME=Customer Admin Portal (live test)
# Build used only by the live Playwright suite (playwright.live.config.ts), which
# drives the real ClientRemoteDatabaseAccessAPI. The API has no CORS policy, so,
# as in production, the portal reaches it on its own origin: vite preview proxies
# /My to the API process the suite starts (see vite.live.config.ts).
VITE_FEATURE_MIGRATIONS=true
